  "titles": [
    {
      "title": "Arabidopsis thaliana Spaceflight Tropism Recognition System: A FAIR-Compliant Pipeline Integrating Bulk Transcriptomics with a Single-Cell Developmental Atlas Foundation Model",
      "titleType": null
    }
  ],
  "descriptions": [
    {
      "description": "A complete computational pipeline for recognizing and classifying tropism responses (gravitropism, phototropism, mechanotropism, hydrotropism) in Arabidopsis thaliana under spaceflight conditions. The pipeline integrates 1,337 bulk RNA-seq and microarray samples from NASA GeneLab OSDR (24 studies) and NCBI GEO (6 series) with the Salk Institute Arabidopsis Developmental Atlas (432,919 nuclei, 183 clusters) as a foundation model. A custom variational auto-decoder (32-dimensional latent space) enables cell-type deconvolution of bulk samples. Differential expression (DESeq2), random-effects meta-analysis (DerSimonian-Laird), and elastic-net classification (AUC=0.919 for Flight vs Ground Control) identify spaceflight-responsive genes and cell types. Results are visualized using ggPlantMap tissue projections, KEGG pathway networks, and standard bioinformatics plots.",
      "descriptionType": "Abstract"
    }
  ],
